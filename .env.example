# Copy to .env (git-ignored) and fill in. Docker Compose reads it.

# Which model the Agent uses: deepseek (deepseek-chat, the default), qwen (qwen-plus on DashScope)
# or offline (no model, no key: only the Agent's built-in rules plan). The keys below are
# optional: without one, the built-in rules plan what they recognise.
AGENT_MODEL_PROVIDER=deepseek
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# Guards the Bank's /admin calls (reset, Bank clock, audit). Only the Bank gets it.
BANK_ADMIN_KEY=demo-admin-key

# Guards the Agent's staff views (sessions, conversation history). The staff console
# needs both this and BANK_ADMIN_KEY; the Agent never gets the Bank's admin key.
AGENT_STAFF_KEY=demo-staff-key

# Optional, for the evaluation runner only (`python -m evaluation`): replay the tasks
# against a running Bank, such as Docker Compose's, instead of one it starts in-process.
# The Agent in Docker always uses http://bank:8000, whatever this says.
# BANK_URL=http://localhost:8000

# Only if the build times out reaching Docker Hub, PyPI or npm, as it can from mainland
# China: uncomment these five lines to build through public mirrors, or use your own.
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com
